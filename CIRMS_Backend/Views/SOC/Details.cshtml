@model CIRMS_Backend.Models.Incident

@{
    ViewData["Title"] = "Incident Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>CIRMS - Incident Details</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f4f1eb;
            color: #172033;
        }

        /* ================= HEADER ================= */

        .top-bar {
            height: 68px;

            background: #ffffff;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 45px;

            border-bottom: 1px solid #ddd8cf;

            box-shadow: 0 2px 8px rgba(0,0,0,.05);
        }

        .top-bar h2 {
            margin: 0;

            color: #172033;

            font-size: 23px;

            font-weight: 700;
        }

        .top-bar h2 i {
            color: #d76b2b;

            margin-right: 8px;
        }

        /* ================= LOGOUT ================= */

        .logout-btn {
            display: inline-flex;

            align-items: center;

            gap: 7px;

            text-decoration: none;

            background: #f3e4da;

            color: #b94e1f !important;

            padding: 10px 17px;

            border-radius: 7px;

            font-size: 13px;

            font-weight: 600;

            transition: .2s;
        }

        .logout-btn:hover {
            background: #d76b2b;

            color: white !important;
        }

        /* ================= MAIN ================= */

        .details-container {
            max-width: 1050px;

            margin: 35px auto 50px;

            padding: 0 25px;
        }

        /* ================= TITLE ================= */

        .page-heading {
            margin-bottom: 20px;
        }

        .page-heading h1 {
            margin: 0;

            color: #172033;

            font-size: 27px;
        }

        .page-heading p {
            margin: 6px 0 0;

            color: #7a7f85;

            font-size: 14px;
        }

        /* ================= INCIDENT CARD ================= */

        .incident-card {
            background: #ffffff;

            border: 1px solid #e1ddd6;

            border-radius: 11px;

            box-shadow: 0 6px 18px rgba(40,35,30,.07);

            overflow: hidden;
        }

        /* ================= INCIDENT HEADER ================= */

        .incident-card-header {
            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 22px 25px;

            background: #273246;

            color: white;
        }

        .incident-card-header h1 {
            margin: 0;

            font-size: 22px;

            font-weight: 700;
        }

        .incident-card-header h1 i {
            color: #e4a23a;

            margin-right: 8px;
        }

        .incident-badge {
            background: #d76b2b;

            color: white;

            padding: 6px 12px;

            border-radius: 20px;

            font-size: 11px;

            font-weight: 700;
        }

        /* ================= INFORMATION ================= */

        .information {
            padding: 25px;
        }

        .section-title {
            display: flex;

            align-items: center;

            gap: 8px;

            margin: 0 0 18px;

            color: #172033;

            font-size: 18px;

            font-weight: 700;
        }

        .section-title i {
            color: #d76b2b;
        }

        /* ================= INFO GRID ================= */

        .info-grid {
            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 13px;

            margin-bottom: 25px;
        }

        .info-item {
            background: #f8f6f2;

            border: 1px solid #e5e0d8;

            border-radius: 8px;

            padding: 15px;
        }

        .info-label {
            display: block;

            color: #858b91;

            font-size: 11px;

            font-weight: 700;

            text-transform: uppercase;

            margin-bottom: 6px;
        }

        .info-value {
            color: #263142;

            font-size: 14px;

            font-weight: 600;

            word-break: break-word;
        }

        /* ================= STATUS ================= */

        .status-badge {
            display: inline-block;

            padding: 5px 11px;

            border-radius: 20px;

            background: #e9f3f1;

            color: #287b70;

            font-size: 11px;

            font-weight: 700;
        }

        /* ================= SOC REPORT ================= */

        .report-box {
            background: #faf8f4;

            border: 1px solid #e5e0d8;

            border-left: 4px solid #3c9b91;

            border-radius: 7px;

            padding: 16px;

            margin-bottom: 28px;

            color: #596575;

            font-size: 14px;

            line-height: 1.6;
        }

        .report-box.empty {
            color: #999;

            font-style: italic;
        }

        /* ================= DIVIDER ================= */

        .divider {
            height: 1px;

            background: #e5e0d8;

            margin: 5px 0 28px;
        }

        /* ================= FORM ================= */

        .investigation-section {
            padding: 0 25px 25px;
        }

        .input-box {
            margin-bottom: 20px;
        }

        .input-box label {
            display: block;

            margin-bottom: 8px;

            color: #4e5865;

            font-size: 13px;

            font-weight: 700;
        }

        select,
        textarea {
            width: 100%;

            border: 1px solid #d8d3cb;

            background: #ffffff;

            color: #273246;

            border-radius: 8px;

            padding: 12px 13px;

            font-family: inherit;

            font-size: 14px;

            outline: none;

            transition: .2s;
        }

        select:focus,
        textarea:focus {
            border-color: #d76b2b;

            box-shadow: 0 0 0 3px rgba(215,107,43,.10);
        }

        textarea {
            resize: vertical;

            min-height: 140px;

            line-height: 1.6;
        }

        /* ================= UPDATE BUTTON ================= */

        .update-btn {
            border: none;

            background: #273246;

            color: white;

            padding: 12px 22px;

            border-radius: 7px;

            font-family: inherit;

            font-size: 13px;

            font-weight: 700;

            cursor: pointer;

            transition: .2s;
        }

        .update-btn i {
            color: #e4a23a;

            margin-right: 6px;
        }

        .update-btn:hover {
            background: #d76b2b;

            transform: translateY(-1px);
        }

        /* ================= BACK BUTTON ================= */

        .back-area {
            margin-top: 22px;

            padding: 0 25px 25px;
        }

        .back-btn {
            display: inline-flex;

            align-items: center;

            gap: 7px;

            text-decoration: none;

            color: #596575;

            background: #f0ede7;

            border: 1px solid #ddd8cf;

            padding: 10px 15px;

            border-radius: 7px;

            font-size: 13px;

            font-weight: 600;

            transition: .2s;
        }

        .back-btn:hover {
            background: #273246;

            color: white;

            border-color: #273246;
        }

        /* ================= RESPONSIVE ================= */

        @@media (max-width: 700px) {

            .top-bar {
                padding: 0 20px;
            }

            .top-bar h2 {
                font-size: 18px;
            }

            .details-container {
                padding: 0 15px;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .incident-card-header {
                padding: 18px;
            }

            .information,
            .investigation-section {
                padding-left: 18px;
                padding-right: 18px;
            }

            .back-area {
                padding-left: 18px;
                padding-right: 18px;
            }

        }

    </style>

</head>


<body>


    <!-- ================= HEADER ================= -->

    <header class="top-bar">

        <h2>

            <i class="fa-solid fa-shield-halved"></i>

            CIRMS - Incident Details

        </h2>


        <a asp-controller="Account"
           asp-action="Logout"
           class="logout-btn">

            <i class="fa-solid fa-right-from-bracket"></i>

            Logout

        </a>

    </header>


    <!-- ================= MAIN ================= -->

    <main class="details-container">


        <div class="page-heading">

            <h1>
                Incident Investigation
            </h1>

            <p>
                Review incident information and update the investigation status.
            </p>

        </div>


        <!-- ================= INCIDENT CARD ================= -->

        <div class="incident-card">


            <!-- HEADER -->

            <div class="incident-card-header">

                <h1>

                    <i class="fa-solid fa-file-shield"></i>

                    INC@(Model.IncidentId.ToString("000"))

                </h1>


                <span class="incident-badge">

                    SOC REVIEW

                </span>

            </div>


            <!-- ================= INFORMATION ================= -->

            <div class="information">


                <h2 class="section-title">

                    <i class="fa-solid fa-circle-info"></i>

                    Incident Information

                </h2>


                <div class="info-grid">


                    <div class="info-item">

                        <span class="info-label">
                            User ID
                        </span>

                        <span class="info-value">
                            @Model.UserId
                        </span>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            Incident Type
                        </span>

                        <span class="info-value">
                            @Model.IncidentType
                        </span>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            IP Address
                        </span>

                        <span class="info-value">
                            @Model.IpAddress
                        </span>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            Severity
                        </span>

                        <span class="info-value">
                            @Model.Severity
                        </span>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            Current Status
                        </span>

                        <span class="info-value">

                            <span class="status-badge">

                                @Model.Status

                            </span>

                        </span>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            Report Date
                        </span>

                        <span class="info-value">
                            @Model.ReportDate.ToString("dd-MM-yyyy HH:mm")
                        </span>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            Evidence
                        </span>

                        <span class="info-value">

                            @(Model.FileName ?? "No evidence")

                        </span>

                    </div>


                </div>


                <!-- ================= SOC REPORT ================= -->

                <h2 class="section-title">

                    <i class="fa-solid fa-clipboard-list"></i>

                    SOC Report

                </h2>


                <div class="report-box @(string.IsNullOrEmpty(Model.SocReport) ? "empty" : "")">

                    @(Model.SocReport ?? "No SOC report yet")

                </div>


                <div class="divider"></div>


            </div>


            <!-- ================= INVESTIGATION ================= -->

            <div class="investigation-section">


                <h2 class="section-title">

                    <i class="fa-solid fa-user-shield"></i>

                    SOC Investigation

                </h2>


                <form asp-controller="Soc"
                      asp-action="UpdateStatus"
                      method="post">


                    <input type="hidden"
                           name="id"
                           value="@Model.IncidentId" />


                    <!-- STATUS -->

                    <div class="input-box">

                        <label for="status">

                            <i class="fa-solid fa-list-check"></i>

                            Status

                        </label>


                        <select name="status"
                                id="status"
                                required>


                            <option value="Pending"
                                    selected="@(Model.Status == "Pending")">

                                Pending

                            </option>


                            <option value="In Progress"
                                    selected="@(Model.Status == "In Progress")">

                                In Progress

                            </option>


                            <option value="Solved"
                                    selected="@(Model.Status == "Solved")">

                                Solved

                            </option>


                        </select>

                    </div>


                    <!-- SOC REPORT -->

                    <div class="input-box">

                        <label for="socReport">

                            <i class="fa-solid fa-pen-to-square"></i>

                            SOC Investigation Report

                        </label>


                        <textarea name="socReport"
                                  id="socReport"
                                  rows="6"
                                  placeholder="Write SOC investigation report...">@Model.SocReport</textarea>

                    </div>


                    <!-- UPDATE -->

                    <button type="submit"
                            class="update-btn">

                        <i class="fa-solid fa-floppy-disk"></i>

                        Update Incident

                    </button>


                </form>


            </div>


            <!-- ================= BACK ================= -->

            <div class="back-area">

                <a asp-controller="Soc"
                   asp-action="Dashboard"
                   class="back-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to SOC Dashboard

                </a>

            </div>


        </div>


    </main>


</body>

</html>