@model List<CIRMS_Backend.Models.User>

@{
    ViewData["Title"] = "User Management";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CIRMS - User Management</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <link rel="stylesheet"
          href="~/css/style.css" />

</head>

<body>

<div class="dashboard">

    <header class="top-bar">

        <h2>CIRMS - User Management</h2>

        <a asp-controller="Account"
           asp-action="Logout"
           class="logout-btn">

            <i class="fa-solid fa-right-from-bracket"></i>
            Logout

        </a>

    </header>


    <nav class="menu">

        <a asp-controller="Admin"
           asp-action="Dashboard">
            Dashboard
        </a>

        <a asp-controller="Admin"
           asp-action="Users">
            Users
        </a>

        <a asp-controller="Account"
           asp-action="Logout">
            Logout
        </a>

    </nav>


    <h2>Registered Users</h2>


    <table>

        <tr>

            <th>User ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Username</th>
            <th>Role</th>

        </tr>


        @if (Model != null && Model.Count > 0)
        {
            foreach (var user in Model)
            {
                <tr>

                    <td>
                        @user.UserId
                    </td>

                    <td>
                        @user.Name
                    </td>

                    <td>
                        @user.Email
                    </td>

                    <td>
                        @user.Username
                    </td>

                    <td>
                        @user.Role
                    </td>

                </tr>
            }
        }
        else
        {
            <tr>

                <td colspan="5">
                    No registered users found.
                </td>

            </tr>
        }

    </table>

</div>

</body>
</html>