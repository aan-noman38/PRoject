 @{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CIRMS - Admin Dashboard</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f4f1eb;
            color: #172033;
        }

        /* ================= HEADER ================= */

        .top-bar {
            height: 68px;
            background: #ffffff;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 45px;

            border-bottom: 1px solid #ddd8cf;

            box-shadow: 0 2px 8px rgba(0,0,0,.05);
        }

        .top-bar h2 {
            margin: 0;

            color: #172033;

            font-size: 23px;
            font-weight: 700;
        }

        .top-bar h2 i {
            color: #d76b2b;
            margin-right: 8px;
        }

        /* ================= LOGOUT ================= */

        .logout-btn {
            display: inline-flex;

            align-items: center;
            gap: 7px;

            text-decoration: none;

            background: #f3e4da;

            color: #b94e1f !important;

            padding: 10px 17px;

            border-radius: 7px;

            font-size: 13px;

            font-weight: 600;

            transition: .2s;
        }

        .logout-btn:hover {
            background: #d76b2b;
            color: white !important;
        }

        /* ================= MENU ================= */

        .menu {
            max-width: 1180px;

            margin: 22px auto 0;

            padding: 0 25px;

            display: flex;

            gap: 8px;
        }

        .menu a {
            display: inline-flex;

            align-items: center;

            gap: 7px;

            text-decoration: none;

            background: #ffffff;

            color: #4d5868;

            border: 1px solid #ddd8cf;

            padding: 10px 17px;

            border-radius: 7px;

            font-size: 13px;

            font-weight: 600;

            transition: .2s;
        }

        .menu a:first-child {
            background: #273246;

            color: white;

            border-color: #273246;

            box-shadow: inset 3px 0 0 #d76b2b;
        }

        .menu a:hover {
            background: #273246;

            color: white;

            border-color: #273246;
        }

        /* ================= WELCOME ================= */

        .welcome {
            max-width: 1180px;

            margin: 35px auto 0;

            padding: 0 25px;
        }

        .welcome h1 {
            margin: 0;

            color: #172033;

            font-size: 28px;

            font-weight: 700;
        }

        .welcome p {
            margin: 7px 0 0;

            color: #7a7f85;

            font-size: 14px;
        }

        /* ================= STATISTICS ================= */

        .card-container {
            max-width: 1180px;

            margin: 25px auto 30px;

            padding: 0 25px;

            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 15px;
        }

        .card {
            position: relative;

            background: #ffffff;

            border: 1px solid #e1ddd6;

            border-radius: 10px;

            padding: 23px;

            min-height: 125px;

            box-shadow: 0 5px 14px rgba(40,35,30,.07);

            overflow: hidden;

            transition: .2s;
        }

        .card:hover {
            transform: translateY(-3px);

            box-shadow: 0 9px 22px rgba(40,35,30,.12);
        }

        /* Card accent */

        .card::before {
            content: "";

            position: absolute;

            left: 0;
            top: 0;

            width: 4px;
            height: 100%;

            background: #3c9b91;
        }

        .card:nth-child(2)::before {
            background: #4c78a8;
        }

        .card:nth-child(3)::before {
            background: #e4a23a;
        }

        .card:nth-child(4)::before {
            background: #6c7a89;
        }

        .card:nth-child(5)::before {
            background: #3c9b91;
        }

        .card:nth-child(6)::before {
            background: #e45b50;
        }

        .card-icon {
            position: absolute;

            right: 20px;
            top: 20px;

            width: 40px;
            height: 40px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background: #f4f1eb;

            color: #596575;

            font-size: 16px;
        }

        .card h3 {
            margin: 0 0 12px;

            color: #7a7f85;

            font-size: 12px;

            font-weight: 600;

            text-transform: uppercase;

            letter-spacing: .3px;
        }

        .card h1 {
            margin: 0;

            color: #172033;

            font-size: 32px;

            font-weight: 700;
        }

        /* ================= ADMINISTRATION ================= */

        .admin-section {
            max-width: 1180px;

            margin: 0 auto 45px;

            padding: 0 25px;
        }

        .admin-title {
            margin: 0 0 18px;

            color: #172033;

            font-size: 21px;

            font-weight: 700;
        }

        .management {
            max-width: none;

            margin: 0;

            padding: 0;

            grid-template-columns: repeat(2, 1fr);
        }

        .management .card {
            min-height: 175px;

            padding: 25px;
        }

        .management .card h3 {
            color: #172033;

            font-size: 17px;

            margin-bottom: 10px;
        }

        .management .card h3 i {
            color: #d76b2b;

            margin-right: 7px;
        }

        .management .card p {
            color: #7a7f85;

            font-size: 13px;

            line-height: 1.6;

            margin: 0 0 20px;
        }

        /* ================= MANAGEMENT BUTTON ================= */

        .management .card a {
            display: inline-flex;

            align-items: center;

            gap: 8px;

            text-decoration: none;

            background: #273246;

            color: white;

            padding: 10px 16px;

            border-radius: 7px;

            font-size: 13px;

            font-weight: 600;

            transition: .2s;
        }

        .management .card a:hover {
            background: #d76b2b;

            transform: translateY(-2px);
        }

        /* ================= RESPONSIVE ================= */

        @@media (max-width: 850px) {

            .card-container {
                grid-template-columns: repeat(2, 1fr);
            }

            .management {
                grid-template-columns: 1fr;
            }

        }

        @@media (max-width: 600px) {

            .top-bar {
                padding: 0 20px;
            }

            .top-bar h2 {
                font-size: 18px;
            }

            .menu {
                flex-wrap: wrap;

                padding: 0 15px;
            }

            .welcome {
                padding: 0 15px;
            }

            .card-container {
                grid-template-columns: 1fr;

                padding: 0 15px;
            }

            .admin-section {
                padding: 0 15px;
            }

        }

    </style>

</head>


<body>


    <!-- ================= HEADER ================= -->

    <header class="top-bar">

        <h2>

            <i class="fa-solid fa-shield-halved"></i>

            CIRMS - Admin Dashboard

        </h2>


        <a asp-controller="Account"
           asp-action="Logout"
           class="logout-btn">

            <i class="fa-solid fa-right-from-bracket"></i>

            Logout

        </a>

    </header>


    <!-- ================= MENU ================= -->

    <nav class="menu">

        <a asp-controller="Admin"
           asp-action="Dashboard">

            <i class="fa-solid fa-chart-line"></i>

            Dashboard

        </a>


        <a asp-controller="Account"
           asp-action="Logout">

            <i class="fa-solid fa-right-from-bracket"></i>

            Logout

        </a>

    </nav>


    <!-- ================= WELCOME ================= -->

    <section class="welcome">

        <h1>
            Administration Dashboard
        </h1>

        <p>
            Monitor users, incidents, and overall CIRMS activity.
        </p>

    </section>


    <!-- ================= STATISTICS ================= -->

    <div class="card-container">


        <!-- TOTAL USERS -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-users"></i>

            </div>

            <h3>
                Total Users
            </h3>

            <h1>
                @ViewBag.TotalUsers
            </h1>

        </div>


        <!-- TOTAL INCIDENTS -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-file-shield"></i>

            </div>

            <h3>
                Total Incidents
            </h3>

            <h1>
                @ViewBag.TotalIncidents
            </h1>

        </div>


        <!-- PENDING -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-clock"></i>

            </div>

            <h3>
                Pending
            </h3>

            <h1>
                @ViewBag.Pending
            </h1>

        </div>


        <!-- IN PROGRESS -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-spinner"></i>

            </div>

            <h3>
                In Progress
            </h3>

            <h1>
                @ViewBag.InProgress
            </h1>

        </div>


        <!-- SOLVED -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-circle-check"></i>

            </div>

            <h3>
                Solved
            </h3>

            <h1>
                @ViewBag.Solved
            </h1>

        </div>


        <!-- CRITICAL -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-triangle-exclamation"></i>

            </div>

            <h3>
                Critical
            </h3>

            <h1>
                @ViewBag.Critical
            </h1>

        </div>


    </div>


    <!-- ================= ADMINISTRATION ================= -->

    <section class="admin-section">

        <h2 class="admin-title">
            Administration
        </h2>


        <div class="card-container management">


            <!-- USER MANAGEMENT -->

            <div class="card">

                <div class="card-icon">

                    <i class="fa-solid fa-user-gear"></i>

                </div>

                <h3>

                    <i class="fa-solid fa-users"></i>

                    User Management

                </h3>

                <p>

                    View and manage registered user information.

                </p>


                <a asp-controller="Admin"
                   asp-action="Users">

                    Manage Users

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>


            <!-- INCIDENT MANAGEMENT -->

            <div class="card">

                <div class="card-icon">

                    <i class="fa-solid fa-file-circle-exclamation"></i>

                </div>

                <h3>

                    <i class="fa-solid fa-shield-virus"></i>

                    Incident Management

                </h3>

                <p>

                    View and manage all reported cyber incidents.

                </p>


                <a asp-controller="Admin"
                   asp-action="Incidents">

                    Manage Incidents

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>


        </div>

    </section>


</body>

</html>