@model List<CIRMS_Backend.Models.Incident>

@{
    ViewData["Title"] = "Incident Management";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CIRMS - Incident Management</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <link rel="stylesheet"
          href="~/css/style.css" />

</head>

<body>

<div class="dashboard">

    <header class="top-bar">

        <h2>CIRMS - Incident Management</h2>

        <a asp-controller="Account"
           asp-action="Logout"
           class="logout-btn">

            <i class="fa-solid fa-right-from-bracket"></i>
            Logout

        </a>

    </header>


    <nav class="menu">

        <a asp-controller="Admin"
           asp-action="Dashboard">
            Dashboard
        </a>

        <a asp-controller="Admin"
           asp-action="Users">
            Users
        </a>

        <a asp-controller="Admin"
           asp-action="Incidents">
            Incidents
        </a>

        <a asp-controller="Account"
           asp-action="Logout">
            Logout
        </a>

    </nav>


    <h2>All Incident Reports</h2>


    <table>

        <tr>

            <th>ID</th>
            <th>User ID</th>
            <th>Incident Type</th>
            <th>IP Address</th>
            <th>Severity</th>
            <th>Status</th>
            <th>Date</th>
            <th>SOC Report</th>

        </tr>


        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>

                    <td>
                        INC@(item.IncidentId.ToString("000"))
                    </td>

                    <td>
                        @item.UserId
                    </td>

                    <td>
                        @item.IncidentType
                    </td>

                    <td>
                        @item.IpAddress
                    </td>

                    <td>
                        @item.Severity
                    </td>

                    <td>
                        @item.Status
                    </td>

                    <td>
                        @item.ReportDate.ToString("dd-MM-yyyy")
                    </td>

                    <td>

                        @if (string.IsNullOrWhiteSpace(item.SocReport))
                        {
                            <span>No SOC report</span>
                        }
                        else
                        {
                            @item.SocReport
                        }

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>

                <td colspan="8">
                    No incident reports found.
                </td>

            </tr>
        }

    </table>

</div>

</body>
</html>